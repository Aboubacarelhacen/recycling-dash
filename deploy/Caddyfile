# Automatic HTTPS: Caddy obtains and renews the certificate itself, so nothing
# here needs a cron job or a manual renewal.

{$SITE_DOMAIN} {
	encode zstd gzip

	# The application is the only upstream; nothing is served from disk here.
	reverse_proxy app:3000

	header {
		# The site is https-only from the first visit onward.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
