# Copy to .env beside docker-compose.yml and fill in. Never commit .env.

# The domain pointing at this machine. Caddy gets a certificate for it, so the
# DNS A record must resolve here before the stack starts.
SITE_DOMAIN=operations.africaluminium.com

POSTGRES_USER=africa
POSTGRES_DB=africa_aluminium
# Generate one, do not invent one: openssl rand -base64 32
POSTGRES_PASSWORD=
